# Copy to .env (or set these in your hosting dashboard)

# Port of the API + web server
PORT=3001

# First-run accounts. If left empty, random passwords are generated and printed
# to the console ONCE. Minimum 8 characters.
ADMIN_PASSWORD=
STAFF_PASSWORD=

# Where db.json (movies, users with hashed passwords, API keys) is stored.
# Mount this as a persistent volume in production.
DATA_DIR=./data

# Behind HTTPS (recommended in production):
# COOKIE_SECURE=true
# If behind a reverse proxy / platform load balancer:
# TRUST_PROXY=true
# Extra allowed origins for state-changing requests (comma separated):
# ALLOWED_ORIGINS=https://admin.example.com

# Public address of this site (used for the Stripe return links and share/SEO links).
# Needed when running behind a proxy.
# PUBLIC_URL=https://example.com

# Stripe can also be set from the admin panel (Settings → Payments). Environment values are used
# when nothing has been saved there.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
